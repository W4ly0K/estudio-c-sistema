generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums basados en el Diccionario de Datos
enum RolUsuario {
  SOLICITANTE
  STAFF
}

enum CategoriaSolicitud {
  PODCAST
  VIDEO
  ESPACIOS
  STREAMING
  ASESORIAS
}

/// Fase 7 (PRD v2.2 secc. 5.1, ADR-007 SE1): dónde ocurre la reserva. Los dos primeros
/// son los sub-espacios físicos; ESTUDIO_COMPLETO ocupa los dos (y es el registro
/// histórico de lo creado antes de la v2.2). CA-06 lo garantizan dos EXCLUDE parciales,
/// uno por sub-espacio físico (migración 20261023120000_ca06_subespacios).
enum SubEspacio {
  CABINA_AUDIO
  ESTUDIO_GRABACION
  ESTUDIO_COMPLETO
}

model Usuario {
  id_usuario  String     @id @default(uuid())
  nombre      String
  correo      String     @unique
  rol         RolUsuario @default(SOLICITANTE)
  
  // Relaciones
  solicitudes      Solicitud[]
  logs_modificados Log_Auditoria[] @relation("StaffModificador")
}

model Solicitud {
  radicado               String             @id
  id_usuario             String
  categoria              CategoriaSolicitud
  proposito              String             @db.Text
  num_participantes      Int?
  fecha_inicio           DateTime
  fecha_fin              DateTime
  /// K9 (Fase 5.5b, ADR-005): las dos fechas de la propuesta existen juntas o ninguna
  /// (Solicitud_propuesta_completa_check), solo en "Pendiente de Reprogramación"
  /// (Solicitud_propuesta_segun_estado_check) y con fin > inicio
  /// (Solicitud_propuesta_fechas_validas_check). Prisma no modela CHECK: ver la
  /// migración 20261008120000_k9_propuesta_coherente.
  fecha_propuesta_inicio DateTime?          // Nullable
  fecha_propuesta_fin    DateTime?          // Nullable
  estado                 String
  es_urgencia            Boolean            @default(false)
  /// Fase 7 (ADR-007 SE1, SE8 y SE10): NOT NULL y SIN valor por defecto desde el contract
  /// (7A.8): quien escribe una solicitud decide su lugar (create() lo escribe siempre). Lo
  /// anterior a la Fase 7 quedó en ESTUDIO_COMPLETO. CA-06 por sub-espacio:
  /// Solicitud_sin_traslape_ca06_cabina y _estudio.
  sub_espacio            SubEspacio
  /// Fase 7 (ADR-007 SE6): el sub-espacio de la propuesta de reprogramación (CA-10, Q-A6).
  /// M4 (Solicitud_propuesta_subespacio_check, contract 7A.8): existe si y solo si existe la
  /// franja propuesta. Prisma no modela CHECK: ver la migración del contract.
  sub_espacio_propuesto  SubEspacio?
  /// Fase 8 · requisito 4: enlace del producto final (https://). Solo en "Entregado" y solo en
  /// PODCAST, VIDEO y STREAMING, donde es obligatorio desde la Fase 8 (CHECK NOT VALID: las
  /// entregas anteriores se conservan sin enlace, DT-3). Ver la migración 20261028130000.
  enlace_entrega         String?            @db.Text

  // Relaciones
  usuario  Usuario             @relation(fields: [id_usuario], references: [id_usuario])
  recursos Solicitud_Recurso[]
  logs     Log_Auditoria[]
}

model Recurso {
  id_recurso     Int    @id @default(autoincrement())
  nombre         String
  cantidad_total Int

  // Relaciones
  solicitudes Solicitud_Recurso[]
}

model Solicitud_Recurso {
  id_detalle          String @id @default(uuid())
  radicado_solicitud  String
  id_recurso          Int
  cantidad_solicitada Int

  // Relaciones
  solicitud Solicitud @relation(fields: [radicado_solicitud], references: [radicado])
  recurso   Recurso   @relation(fields: [id_recurso], references: [id_recurso])
}

model Log_Auditoria {
  id_log             String   @id @default(uuid())
  radicado_solicitud String
  estado_anterior    String
  estado_nuevo       String
  modificado_por     String
  fecha_modificacion DateTime @default(now())
  /// T2 (Fase 6.5b, DE1): justificación del Staff al rechazar. Existe si y solo si el
  /// log registra T2 (estado_nuevo = "Rechazado"; Log_Auditoria_motivo_rechazo_segun_estado_check)
  /// y mide entre 10 y 500 caracteres sin los espacios de los extremos
  /// (Log_Auditoria_motivo_rechazo_longitud_check). Prisma no modela CHECK: ver la
  /// migración 20261013120000_motivo_rechazo.
  motivo_rechazo     String?  @db.Text
  /// CA-10 · K7 (Fase 6.1b, Decisión DB1): justificación del Staff al proponer una
  /// reprogramación. Existe si y solo si el log registra T5 (estado_nuevo = "Pendiente
  /// de Reprogramación"; Log_Auditoria_motivo_reprogramacion_segun_estado_check) y mide
  /// entre 10 y 500 caracteres sin los espacios de los extremos
  /// (Log_Auditoria_motivo_reprogramacion_longitud_check). Prisma no modela CHECK: ver
  /// la migración 20261009200000_motivo_reprogramacion.
  motivo_reprogramacion String? @db.Text
  /// Fase 7 (ADR-007 SE7, Q-A12): de qué sub-espacio a cuál cambió la reserva. Van juntos
  /// (Log_Auditoria_sub_espacio_completo_check), son distintos (_cambio_real_check) y solo
  /// en T1 o T7, que terminan en "Validado" (_segun_estado_check).
  sub_espacio_anterior  SubEspacio?
  sub_espacio_nuevo     SubEspacio?
  /// Fase 7 (ADR-007 P-1, Q-B2): la franja que tenía la solicitud antes de que el Staff la
  /// ajustara al aprobar (T1) o el solicitante aceptara otra (T7). Van juntas
  /// (Log_Auditoria_franja_anterior_completa_check), fin > inicio (_valida_check) y solo
  /// en "Validado" (_segun_estado_check). Prisma no modela CHECK: ver la migración
  /// 20261023120000_ca06_subespacios.
  fecha_inicio_anterior DateTime?
  fecha_fin_anterior    DateTime?

  // Relaciones
  solicitud  Solicitud @relation(fields: [radicado_solicitud], references: [radicado])
  usuario    Usuario   @relation("StaffModificador", fields: [modificado_por], references: [id_usuario])
}