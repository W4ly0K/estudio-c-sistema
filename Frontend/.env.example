# Copia este archivo como .env.local (ignorado por Git) y completa los valores.
# Las variables VITE_* quedan dentro del bundle del navegador: nunca pongas secretos aquí.

# URL base de la API, sin barra final.
VITE_API_URL=http://localhost:3000

# Client ID de Google OAuth (Google Cloud Console > Credenciales). Es público, no secreto.
VITE_GOOGLE_CLIENT_ID=
